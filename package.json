{
  "name": "sidework-browser",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Independent local AI browser with approval-bound actions and verifiable jobs",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "qa": "node scripts/electron-qa.mjs",
    "package:mac": "electron-builder --mac dir --arm64",
    "package:zip": "electron-builder --mac zip --arm64"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.sidework.codex",
    "productName": "Sidework Codex",
    "directories": {
      "output": "release-task-spaces"
    },
    "files": [
      "dist-desktop/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
